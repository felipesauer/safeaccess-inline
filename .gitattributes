# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source files
*.php text diff=php
*.ts text diff=typescript
*.js text diff=javascript
*.json text
*.yml text
*.yaml text
*.xml text
*.md text
*.txt text
*.ini text
*.env text
*.neon text

# Config files
*.editorconfig text
.gitattributes text
.gitignore text

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.tar.gz binary
*.pdf binary

# Export ignore - files excluded from `git archive`
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.github/ export-ignore
/.husky/ export-ignore
/.nvmrc export-ignore
/docs/ export-ignore
/commitlint.config.js export-ignore
/.lintstagedrc.json export-ignore
/package.json export-ignore
/release-please-config.json export-ignore
/.release-please-manifest.json export-ignore
/.mnema/ export-ignore
/.prettierignore export-ignore
/.prettierrc.json export-ignore
/AGENTS.md export-ignore
/CHANGELOG.md export-ignore
/CLAUDE.md export-ignore
/CONTRIBUTING.md export-ignore
/SECURITY.md export-ignore
/codecov.yml export-ignore
/eslint.config.js export-ignore
/package-lock.json export-ignore

# The archive GitHub serves (what `composer require` downloads) holds only the PHP package:
# composer.json, LICENSE, README.md and packages/php/{src,README.md,CHANGELOG.md}.
/packages/js/ export-ignore
/packages/php/composer.json export-ignore
/packages/php/LICENSE export-ignore

# GitHub Linguist overrides
packages/php/vendor/ linguist-vendored
docs/ linguist-documentation
